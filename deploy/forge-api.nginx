# /etc/nginx/sites-available/forge-api
#
# forge-api.zafrika.com — the FORGE backend.
#
# Serves the JSON API, the Django admin, uploaded media and the static files
# the admin needs. The web client is a separate deployment; this host answers
# only for the API.

upstream forge_app {
    server unix:/var/www/forge-api/forge.sock;
}

# Rate limiting at the edge.
#
# The application throttles too, but by the time Django is throttling a
# request a worker has already been occupied parsing it — and this box has two
# workers. These zones are the cheap outer layer: they cost nginx almost
# nothing and they never reach Python.
limit_req_zone $binary_remote_addr zone=forge_auth:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=forge_api:10m rate=120r/m;
limit_conn_zone $binary_remote_addr zone=forge_conn:10m;

server {
    listen 80;
    listen [::]:80;
    server_name forge-api.zafrika.com;

    location /.well-known/acme-challenge/ { root /var/www/html; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name forge-api.zafrika.com;

    # certbot fills these in on first issue.
    ssl_certificate     /etc/letsencrypt/live/forge-api.zafrika.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/forge-api.zafrika.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # Uploaded screenshots are small by policy; the signed portfolio export is
    # the largest thing a client ever posts back.
    client_max_body_size 8m;
    client_body_timeout 30s;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy same-origin always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    gzip on;
    gzip_types application/json application/javascript text/css text/plain application/xml;
    gzip_min_length 512;

    access_log /var/log/nginx/forge-api.access.log;
    error_log  /var/log/nginx/forge-api.error.log;

    limit_conn forge_conn 24;

    # Sign-in and registration. Tight, and burst-free on purpose: a legitimate
    # person signs in once, and an attacker gets no queue to hide in.
    location ~ ^/api/v1/accounts/(token|register|accept-invitation|verify-email|resend-verification)/ {
        limit_req zone=forge_auth burst=5 nodelay;
        proxy_pass http://forge_app;
        include /etc/nginx/proxy_params;
        proxy_set_header X-Forwarded-Proto https;
    }

    location /static/ {
        alias /var/www/forge-api/staticfiles/;
        expires 30d;
        access_log off;
        add_header Cache-Control "public, immutable";
    }

    location /media/ {
        alias /var/www/forge-api/media/;
        expires 7d;
        access_log off;
        # Uploads are member-supplied: never let one be interpreted as a script.
        add_header X-Content-Type-Options nosniff always;
        add_header Content-Disposition "inline" always;
    }

    location / {
        limit_req zone=forge_api burst=40 nodelay;
        proxy_pass http://forge_app;
        include /etc/nginx/proxy_params;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 60s;
    }
}
