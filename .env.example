# ---------------------------------------------------------------------------
# FORGE backend environment
#
# Copy to .env and fill in. NOTHING IN .env IS EVER COMMITTED -- the platform
# is developed in the open, and a public repository with student contributors
# is exactly how credentials leak. .gitignore covers it; do not override that.
# ---------------------------------------------------------------------------

DEBUG=True
DJANGO_SECRET_KEY=generate-a-long-random-value-for-this
ALLOWED_HOSTS=localhost,127.0.0.1
PUBLIC_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO

# Database -------------------------------------------------------------------
DATABASE_URL=postgres://forge:forge@localhost:5432/forge

# Identity -------------------------------------------------------------------
# Only addresses on these domains may register as students. Confirm the real
# list with the Directorate of ICT before any pilot.
UNIVERSITY_EMAIL_DOMAINS=ouk.ac.ke,students.ouk.ac.ke

# When the University exposes single sign-on, set these and flip OIDC_ENABLED.
# No code change is needed.
OIDC_ENABLED=False
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

EMAIL_VERIFICATION_TTL_HOURS=24

# Portfolio signing ----------------------------------------------------------
# Generate with: python manage.py generate_signing_key
# Without this, exports are issued unsigned and marked as unverifiable.
PORTFOLIO_SIGNING_KEY=
PORTFOLIO_SIGNING_KEY_ID=forge-key-1

# Email ---------------------------------------------------------------------
# Port 26, not 25/465/587. Most cloud providers filter the others, and a send
# to a filtered port does not fail -- it hangs until EMAIL_TIMEOUT and nothing
# in the logs says why. cPanel-style hosts listen on 26, which is rarely
# filtered and speaks STARTTLS.
#
# Check what is actually reachable from wherever you are running:
#   python manage.py check_email
#   python manage.py check_email --to you@example.com
#
# The console backend just prints to the terminal and is the default in
# development. Set EMAIL_BACKEND below to send for real.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=26
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=15
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=FORGE <forge@example.com>
SUPPORT_EMAIL=forge@example.com

# Where the web client runs. Verification links and portfolio URLs are built
# against this, so it must be the site a member actually opens -- not the API.
FRONTEND_BASE_URL=http://localhost:5173

# Cache ----------------------------------------------------------------------
# NOT optional in production: throttle counters and sign-in lockouts live here.
# With the local-memory fallback each worker keeps its own counters, so a limit
# of "10 a minute" silently becomes "10 a minute per worker".
REDIS_URL=

# Rate limits ----------------------------------------------------------------
# Global ceilings, applied to every request.
THROTTLE_ANON_BURST=60/min
THROTTLE_ANON_SUSTAINED=600/hour
THROTTLE_USER_BURST=180/min
THROTTLE_USER_SUSTAINED=3000/hour
# Credential endpoints. Sign-in is additionally protected by a lockout with a
# backoff -- see forge/accounts/lockout.py -- because a rate limit alone still
# permits thousands of guesses a day.
THROTTLE_LOGIN=10/min
THROTTLE_LOGIN_EMAIL=8/hour
THROTTLE_REGISTRATION=5/hour
THROTTLE_EMAIL_VERIFICATION=6/hour
# Work that costs the platform something.
THROTTLE_EXPENSIVE=30/hour
THROTTLE_PDF=40/hour
THROTTLE_INVITE=60/day

# Joining --------------------------------------------------------------------
# Students never choose their own password: credentials are generated and
# emailed to the University address, so opening an account requires being able
# to read that mailbox.
CREDENTIALS_BY_EMAIL=True
INVITATION_TTL_DAYS=14

# Background work ------------------------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Frontend -------------------------------------------------------------------
# Every origin the web client is served from. Exact matches only -- no
# wildcards, so a Vercel preview deployment on a generated subdomain will be
# refused until its URL is added here too.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Defaults to CORS_ALLOWED_ORIGINS; set separately only if they differ.
CSRF_TRUSTED_ORIGINS=

# Operations -----------------------------------------------------------------
SENTRY_DSN=
SECURE_SSL_REDIRECT=False
