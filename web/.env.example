# The FORGE API's origin.
#
# Leave it empty in development: requests then go to /api/v1 and Vite's proxy
# forwards them to the local Django server, which keeps dev same-origin and
# needs no CORS configuration.
#
# Set it for any built deployment, where the client and the API are on
# different hosts. Vite inlines this at build time, so changing it means
# rebuilding — restarting is not enough.
#
#   VITE_API_BASE_URL=https://forge-api.zafrika.com
VITE_API_BASE_URL=
